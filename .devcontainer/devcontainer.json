{
    "name": "DEBUG-AGENT-MVP Workspace",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "overrideCommand": true,
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            },
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ]
        }
    },
    "remoteUser": "root",
    "workspaceFolder": "/workspace"
}