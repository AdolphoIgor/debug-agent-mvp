# Relational Infrastructure
POSTGRES_USER=mvp_user
POSTGRES_PASSWORD=mvp_password
POSTGRES_DB=mvp_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Vector Storage
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# Model Context Protocol Sidecar
MCP_SERVER_HOST_PORT=8081
MCP_SERVER_SSE_URL=http://mcp-server:8080/sse

# LLM Providers & Quota Management
GEMINI_API_KEY=
GOOGLE_API_KEY=
GCP_PROJECT_ID=debug-agent-mvp

# Ephemeral Sandbox Runtime
SANDBOX_IMAGE=mvp-sandbox:latest
SANDBOX_TIMEOUT_SEC=120

# Orchestrator Internal Paths & Networks
DOCKER_NETWORK_NAME=mvp_global_net
PYTHONPATH=/workspace:/workspace/src