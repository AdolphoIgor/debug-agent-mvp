# PostgreSQL Configuration
POSTGRES_USER=mvp_user
POSTGRES_PASSWORD=mvp_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mvp_db
BASELINE_DB_NAME=client_baseline_db

# Assembled Database URLs
DATABASE_URL=postgresql://mvp_user:mvp_password@postgres:5432/mvp_db
TARGET_DB_URL=postgresql://mvp_user:mvp_password@postgres:5432/client_baseline_db

# Qdrant Vector Store Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# FastMCP Server Configuration
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=8080
MCP_SERVER_SSE_URL=http://mcp-server:8080/sse

# Record & Playback Proxy Configuration
RECORD_PROXY_HOST=record-proxy
RECORD_PROXY_PORT=8080
MVP_RECORD_PLAY_PROXY_URL=http://record-proxy:8080

# Google Cloud Platform & AI SDK Configuration
GCP_PROJECT_ID=debug-agent-mvp
GOOGLE_API_KEY=your-google-ai-studio-key

# Application & Environment Runtime Settings
PYTHONPATH=/workspace/src
SANDBOX_TIMEOUT_SEC=120
DOCKER_NETWORK_NAME=mvp_global_net